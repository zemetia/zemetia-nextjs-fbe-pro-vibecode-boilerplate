/// Approval segment — lapis persetujuan direktur/owner di atas dokumen yang
/// sudah ada. Identifiers stay in English; label Bahasa Indonesia dipetakan di
/// lapis presentasi (`*_LABELS` di `src/lib/approval.ts`).

/// **Satu enum, bukan dua sumbu.** Godaannya memodelkan ini sebagai
/// `subjectType` × `action` — dan sebagian besar selnya tidak akan pernah ada
/// (tidak ada "voucher dirilis", tidak ada "SPK diterima"). Matriks dengan sel
/// kosong permanen bukan "belum terisi", ia keadaan yang seharusnya tidak bisa
/// direpresentasikan; jadi yang disimpan adalah **pasangan dokumen+keputusan**
/// yang memang sah, satu nilai masing-masing.
///
/// Menambah jenis persetujuan = tambah satu nilai di sini, lalu
/// `APPROVAL_KIND_PERMISSION` dan `executeApproval()` gagal compile sampai
/// keduanya menjawab nilai barunya — peta izin dan pelaksananya tidak bisa
/// tertinggal diam-diam.
///
/// METAL_PURCHASE_CONFIRM          — mengunci dokumen pembelian LM
/// METAL_PURCHASE_DELIVERY_CONFIRM — menyatakan barang benar-benar diterima
/// CASH_VOUCHER_APPROVE            — menyetujui voucher keuangan
/// PRODUCTION_ORDER_RELEASE        — merilis SPK ke lantai produksi
enum ApprovalKind {
  METAL_PURCHASE_CONFIRM
  METAL_PURCHASE_DELIVERY_CONFIRM
  CASH_VOUCHER_APPROVE
  PRODUCTION_ORDER_RELEASE
}

/// PENDING   — menunggu keputusan; dokumennya terhitung "menunggu persetujuan"
/// APPROVED  — disetujui, dan transisi dokumennya **sudah** dijalankan
/// REJECTED  — ditolak; dokumennya tidak berubah dan tetap bisa diperbaiki
/// CANCELLED — ditarik kembali oleh pengajunya sebelum diputuskan
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Satu permintaan konfirmasi atas satu dokumen.
///
/// **Status "menunggu persetujuan" tidak punya kolom di dokumennya.** Dokumen
/// tetap `DRAFT`; yang menyatakan ia sedang menunggu adalah adanya baris PENDING
/// di sini. Menyalinnya jadi status keenam di setiap enum dokumen melahirkan dua
/// jawaban untuk satu fakta yang pasti akan berselisih suatu hari — alasan yang
/// sama dengan saldo akun yang diturunkan dari `journal_lines` dan `origin` mitra
/// yang diturunkan dari negaranya.
///
/// **Menyetujui = menjalankan transisinya, dalam satu transaksi.** Permintaan
/// bertanda APPROVED yang dokumennya gagal dikonfirmasi adalah kebohongan yang
/// tidak punya cara ketahuan; jadi keduanya mendarat bersama atau tidak sama
/// sekali (`executeApproval()` di `src/lib/approval-write.ts`).
///
/// **Sebaliknya juga berlaku.** Direktur yang mengkonfirmasi dokumennya langsung
/// dari halaman dokumen sudah memutuskan hal yang sama, jadi transisi dokumen
/// ikut menutup permintaan yang menggantung (`resolvePendingApproval()`) — kalau
/// tidak, inbox akan penuh baris yang subjeknya sudah lewat.
///
/// **`subjectId` tanpa FK**, pola yang sama dengan `referenceType`/`referenceId`
/// di `JournalEntry` dan `MetalMovement`: satu tabel menunjuk empat model, dan
/// jejak persetujuan tidak boleh bisa ditarik ikut terhapus oleh dokumennya.
model ApprovalRequest {
  id     String         @id @default(cuid())
  /// `APR-202608-0001`, direset tiap bulan. Tidak pernah diketik.
  number String         @unique
  kind   ApprovalKind
  status ApprovalStatus @default(PENDING)

  /// Id dokumen yang dimintakan keputusannya. Modelnya ditentukan `kind`.
  subjectId String

  /// **Kunci keunikan parsial, dan hanya itu gunanya.** Berisi `'PENDING'`
  /// selama permintaannya terbuka dan `NULL` sesudah diputuskan; karena Postgres
  /// tidak pernah menganggap dua NULL bertabrakan, `@@unique` di bawah berarti
  /// "maksimal satu permintaan terbuka per dokumen per jenis" sementara riwayat
  /// keputusan lamanya boleh sebanyak apa pun.
  ///
  /// Ditulis partial unique index (`WHERE status = 'PENDING'`) akan lebih jujur,
  /// tapi Prisma tidak bisa menyatakannya — dan indeks yang tidak dikenal skema
  /// akan dilaporkan `migrate diff` sebagai drift selamanya.
  pendingKey String?

  /// Catatan pengaju. Opsional — nomor dokumennya sudah menjelaskan apa yang
  /// diminta, dan memaksa kalimat di sini hanya melahirkan "mohon approve".
  requestNote   String?
  requestedById String
  requestedAt   DateTime @default(now())

  /// Terisi bersamaan begitu keputusannya jatuh. Catatan penolakan **tidak
  /// wajib** — keputusan developer: menolak dengan cepat lebih berguna daripada
  /// menolak dengan paragraf, dan yang ditolak masih duduk di layar pengajunya.
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([kind, subjectId, pendingKey])
  @@index([status, requestedAt])
  @@index([kind, status])
  @@index([subjectId])
  @@index([requestedById])
  @@map("approval_requests")
}
