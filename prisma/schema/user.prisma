model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  roleId        String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role     Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  accounts Account[]
  sessions Session[]

  partnerVerificationsRequested Partner[] @relation("PartnerVerificationRequestedBy")
  partnerVerificationsReviewed  Partner[] @relation("PartnerVerificationReviewedBy")

  journalEntriesCreated JournalEntry[] @relation("JournalCreatedBy")
  journalEntriesPosted  JournalEntry[] @relation("JournalPostedBy")
  journalEntriesVoided  JournalEntry[] @relation("JournalVoidedBy")

  metalLotsCreated MetalLot[] @relation("MetalLotCreatedBy")

  metalMovementsCreated MetalMovement[] @relation("MetalMovementCreatedBy")
  metalMovementsPosted  MetalMovement[] @relation("MetalMovementPostedBy")
  metalMovementsVoided  MetalMovement[] @relation("MetalMovementVoidedBy")

  cashVouchersCreated  CashVoucher[] @relation("CashVoucherCreatedBy")
  cashVouchersReviewed CashVoucher[] @relation("CashVoucherReviewedBy")
  cashVouchersPosted   CashVoucher[] @relation("CashVoucherPostedBy")
  cashVouchersVoided   CashVoucher[] @relation("CashVoucherVoidedBy")

  approvalRequestsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalRequestsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  productionOrdersCreated  ProductionOrder[] @relation("ProductionOrderCreatedBy")
  productionOrdersReleased ProductionOrder[] @relation("ProductionOrderReleasedBy")
  productionOrdersClosed   ProductionOrder[] @relation("ProductionOrderClosedBy")
  productionOrdersVoided   ProductionOrder[] @relation("ProductionOrderVoidedBy")

  purchaseRequestsCreated  PurchaseRequest[] @relation("PurchaseRequestCreatedBy")
  purchaseRequestsApproved PurchaseRequest[] @relation("PurchaseRequestApprovedBy")
  purchaseRequestsVoided   PurchaseRequest[] @relation("PurchaseRequestVoidedBy")

  purchasesCreated          PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  purchasesConfirmed        PurchaseOrder[] @relation("PurchaseOrderConfirmedBy")
  purchasesDirectorApproved PurchaseOrder[] @relation("PurchaseOrderDirectorApprovedBy")
  purchasesVoided           PurchaseOrder[] @relation("PurchaseOrderVoidedBy")

  purchaseDeliveriesCreated      GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  purchaseDeliveriesShipped      GoodsReceipt[] @relation("GoodsReceiptShippedBy")
  purchaseDeliveriesConfirmed    GoodsReceipt[] @relation("GoodsReceiptConfirmedBy")
  purchaseDeliveriesReceived     GoodsReceipt[] @relation("GoodsReceiptReceivedBy")
  purchaseDeliveriesVaultOfficer GoodsReceipt[] @relation("GoodsReceiptVaultOfficer")
  purchaseDeliveriesDirector     GoodsReceipt[] @relation("GoodsReceiptDirector")
  purchaseDeliveriesVoided       GoodsReceipt[] @relation("GoodsReceiptVoidedBy")

  salesOrdersCreated          SalesOrder[] @relation("SalesOrderCreatedBy")
  salesOrdersConfirmed        SalesOrder[] @relation("SalesOrderConfirmedBy")
  salesOrdersDirectorApproved SalesOrder[] @relation("SalesOrderDirectorApprovedBy")
  salesOrdersVoided           SalesOrder[] @relation("SalesOrderVoidedBy")

  salesDeliveriesCreated   SalesDelivery[] @relation("SalesDeliveryCreatedBy")
  salesDeliveriesConfirmed SalesDelivery[] @relation("SalesDeliveryConfirmedBy")
  salesDeliveriesVoided    SalesDelivery[] @relation("SalesDeliveryVoidedBy")

  salesInvoicesDirectorApproved SalesInvoice[] @relation("SalesInvoiceDirectorApprovedBy")
  salesInvoicesCreated          SalesInvoice[] @relation("SalesInvoiceCreatedBy")
  salesInvoicesVoided           SalesInvoice[] @relation("SalesInvoiceVoidedBy")

  @@map("users")
}
